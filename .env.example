# LORD - Legend of the Red Dragon
# Copy this file to .env and customize as needed.
# .env is gitignored and must never be committed.
# CLI tools can load a different file with --env-file <path>.
# Docker Compose can inject variables with env_file: or environment.
#
# All game settings can be overridden here using the LORD_ prefix.
# Values here override the defaults in data/settings.json.
# Environment variables set externally (e.g. via Docker) take precedence over .env.

# ── Server Settings ──────────────────────────────────────────────────────

# Public HTTP server port (optional) - used by reverse proxy / static assets
# HTTP_PORT=80

# Telnet server port (set to empty, false, or null to disable)
# TELNET_PORT=2323

# Sentry error reporting DSN
# SENTRY_DSN=

# ── BBS Door Settings ───────────────────────────────────────────────────

# Use the drop-file alias as the player name in door mode; false uses the real name
# LORD_DOOR_USE_ALIAS=true

# Comma-separated time warnings for door mode, in minutes remaining
# LORD_DOOR_TIME_WARN=5,2,1

# Drop file search directory for door mode; default is the current working directory
# LORD_DOOR_DROP_DIR=

# ── Game Settings ────────────────────────────────────────────────────────

# Runtime data directory - writable state (database, IGM data, etc.)
# Relative paths are resolved against the project root; absolute paths used as-is.
# This allows running multiple game instances from the same codebase.
# LORD_RUNTIME_DIR=runtime
# LORD_RUNTIME_DIR=./runtime2
# LORD_RUNTIME_DIR=/var/lord-data/game1

# Separate local runtime directory for auth users and shared web sessions; leave blank to share LORD_RUNTIME_DIR
# LORD_AUTH_RUNTIME_DIR=

# Storage backend: sqlite, dat, or synchronet
# LORD_STORAGE_BACKEND=sqlite

# Synchronet lordsrv host, optionally host:port; used only when LORD_STORAGE_BACKEND=synchronet
# LORD_REMOTE_GAME=

# BBS username for the Synchronet lordsrv backend
# LORD_GAME_USER=

# BBS password for the Synchronet lordsrv backend
# LORD_GAME_PASS=

# Inactivity timeout in seconds (0 = no timeout)
# LORD_TIMEOUT=900

# Number of forest fights per day
# LORD_FOREST_FIGHTS=15

# Number of PvP fights per day
# LORD_PVP_FIGHTS_PER_DAY=3

# Cap PvP gold rewards to floor(attacker forest-gold average * factor); 0 keeps the stock full-loot reward
# LORD_PVP_GOLD_LOOT_CAP_FACTOR=0

# Cap PvP gem rewards after the stock half-gem calculation; 0 keeps the stock reward
# LORD_PVP_GEM_LOOT_CAP=0

# Days before inactive accounts are deleted (0 = never)
# LORD_DELETE_DAYS=15

# Hide inactive accounts instead of deleting them
# LORD_INACTIVE_PLAYER_POLICY=delete

# Delete players with 1 XP during cleanup
# LORD_DEL_1XP=true

# Number of dragon kills required to win
# LORD_WIN_DEEDS=3

# Days before resurrection is allowed
# LORD_RES_DAYS=3

# Spread inactive-player resurrections across this many minutes after day rollover
# LORD_INACT_RES_SPREAD_MINS=0

# Bank interest percentage (applied daily)
# LORD_BANK_INTEREST=10

# ── Feature Toggles ─────────────────────────────────────────────────────
# Enable gold transfers between players
# LORD_TRANSFERS_ON=true
# LORD_TRANSFERS_PER_DAY=2
# LORD_TRANSFER_AMOUNT=2000000

# Maximum total gold a player may send by bank transfer in one day; 0 disables the cap
# LORD_BANK_XFER_GOLD_CAP=0

# Reset the daily bank-transfer gold cap when a player kills the dragon
# LORD_BANK_XFER_GOLD_RESET_KILL=false

# Filter profanity from chat
# LORD_CLEAN_MODE=false

# Disable chat system
# LORD_NOCHAT=false

# Disable all IGMs (In-Game Modules)
# LORD_NO_IGMS_ALLOWED=false

# Enable Olivia encounters
# LORD_OLIVIA=true

# Enable funky garden flowers
# LORD_FUNKY_FLOWERS=true

# Allow flower garden background color codes when funky flowers are enabled
# LORD_FLOWER_BG_COLORS=true

# Keep level 1 monster encounters available in higher-level forest mixed pools
# LORD_FOREST_L1_ABOVE_L1=true

# Allow generic forest monsters to use enemy power moves
# LORD_FOREST_POWER_MOVES=true

# Probability that the NPC bar responder posts chatter during daily maintenance
# LORD_BAR_NPC_CHATTER_PROB=0.5

# Require the usual strength and defense thresholds when buying weapons and armour
# LORD_SHOP_LIMIT=true

# Allow buying back a just-sold shop item during the same visit
# LORD_SHOP_BUYBACK_ENABLED=false

# Restore the just-sold shop item when an upgrade purchase fails
# LORD_SHOP_RESTORE_ITEM_ON_FAIL=false

# Send a canned fallback message when mail is submitted with a blank first line
# LORD_BLANK_MAIL_DEFAULT_MSG=true

# Allow players to block mail, PvP targeting, and bank transfers from specific players
# LORD_PLAYER_BLOCKING=false

# Shared-IP restriction window in game days; 0 disables the restriction
# LORD_SHARED_IP_WINDOW_DAYS=0

# Block PvP between players who recently shared an IP
# LORD_SHARED_IP_BLOCK_PVP=false

# Block bank transfers between players who recently shared an IP
# LORD_SHARED_IP_BLOCK_BANK_XFER=false

# Block only romantic mail between players who recently shared an IP
# LORD_SHARED_IP_BLOCK_ROMANCE=false

# Ignore RFC1918, loopback, and link-local addresses when recording shared-IP history
# LORD_SHARED_IP_IGNORE_PRIVATE=true

# Limit announcement length and daily usage; 0 disables each cap
# LORD_ANNOUNCEMENT_MAX_LINES=0
# LORD_ANN_MAX_PER_PLAYER_DAY=0
# LORD_ANN_MAX_TOTAL_DAY=0
# LORD_ANN_MAX_CHARS_LINE=75

# Open a midnight maintenance window for this many seconds; set force_disconnect
# to close active sessions so scheduled maintenance can run during the window
# LORD_MAINT_WINDOW_SECONDS=0
# LORD_MAINT_FORCE_DISCONNECT=false

# Automatically reset a completed round during scheduled maintenance
# LORD_AUTO_RESET_WON_ROUND=false

# Use the legacy 5-skill-point rule for Death Knight and thief daily uses, unless the explicit divisor settings override it
# LORD_OLD_SKILL_POINTS=false

# Skill lessons required per extra daily Death Knight use
# LORD_DK_USE_POINT_DIVISOR=4

# Skill lessons required per extra daily thief use
# LORD_THIEF_USE_POINT_DIVISOR=4

# Award +3 defense after killing another player
# LORD_DEF_FOR_PK=false

# Award +2 strength after killing another player
# LORD_STR_FOR_PK=false

# Multiplier applied to Death Knight power-attack damage (3.0 = stock, 3.3 = legacy boost)
# LORD_DK_DAMAGE_MULTIPLIER=3.0

# Damage the dragon takes when your horse dies intercepting its attack
# LORD_DRAGON_HORSE_SAC_DAMAGE=0

# Legacy alias for a 3.3x Death Knight damage multiplier when the explicit multiplier is left at stock
# LORD_DK_BOOST=false

# Block offline PvP targeting when the victim is already in another battle
# LORD_BLOCK_PVP_IF_IN_BATTLE=false

# Refuse login while a player is still tied to an unresolved offline PvP battle
# LORD_BLOCK_LOGIN_PEND_BATTLE=false

# Anti-camping dragon wake-up: eligible high-level sleepers can be dragged into an immediate Red Dragon fight
# LORD_SLEEP_DRAGON=false

# Legacy compatibility flag for the old ugly-stick forest event; currently unused in the TypeScript port

# Use the old thief fairy bank-steal payout formula; true uses level^3, false uses linear level scaling
# LORD_OLD_STEAL=true

# After you have dragon kills, some monsters can gain extra HP and strength based on your dragon-kill count
# LORD_BEEF_UP=false

# When a login reuses a node slot, mark any stale previous occupant on that node offline before claiming it
# LORD_SAFE_NODE=true

# Erase the ANSI MORE prompt in place after Continue; false leaves a blank line instead
# LORD_USE_FANCY_MORE=true

# ── Display Settings ─────────────────────────────────────────────────────
# BBS/realm name shown to players
# LORD_SYSTEM_NAME=The Realm

# IANA timezone for day boundaries (e.g. America/New_York, UTC)
# LORD_TIMEZONE=UTC

# ── SMTP Notifications ───────────────────────────────────────────────────
# All SMTP_* variables must be set to enable email notifications when the game ends.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=noreply@example.com
# SMTP_TO=admin@example.com
